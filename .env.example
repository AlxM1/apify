# ── Apify Scraper Suite Configuration ──────────────────────
# Copy this file to .env and customize as needed.

# App settings
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Database (default: SQLite in ./data/apify.db)
# DATABASE_URL=sqlite+aiosqlite:///./data/apify.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/apify

# Authentication (leave empty to disable auth)
API_KEY=
# JWT_SECRET=change-me-in-production
# JWT_EXPIRE_MINUTES=1440

# Scraping defaults
DEFAULT_MAX_RESULTS=100
DEFAULT_DELAY=1.0
DEFAULT_HEADLESS=true
# DEFAULT_PROXY=http://user:pass@proxy:8080
# PROXY_LIST_FILE=./proxies.txt

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_CHECK_INTERVAL=60

# Data retention (auto-delete old jobs)
RETENTION_ENABLED=false
RETENTION_DAYS=30

# API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT=60/minute

# Webhook notifications (POST on job completion)
# WEBHOOK_URL=http://localhost:5678/webhook/scrape-done
# WEBHOOK_SECRET=your-hmac-secret

# n8n integration
# N8N_BASE_URL=http://localhost:5678

# Telegram scraper credentials
# TELEGRAM_API_ID=12345
# TELEGRAM_API_HASH=abcdef123456
